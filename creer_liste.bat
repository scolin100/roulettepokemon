@echo off
chcp 65001 >nul
rem Génère liste.js : la liste des images du dossier "allpokemon" (à relancer si tu ajoutes/retires des images)
powershell -NoProfile -ExecutionPolicy Bypass -Command "$names = @(Get-ChildItem -LiteralPath '%~dp0allpokemon' -File | Where-Object { $_.Extension -match '^\.(gif|png|jpe?g|webp|avif|bmp)$' } | ForEach-Object { $_.Name }); $json = ConvertTo-Json -InputObject $names -Compress; [System.IO.File]::WriteAllText('%~dp0liste.js', 'window.POKEMON_LIST = ' + $json + ';', (New-Object System.Text.UTF8Encoding($false))); Write-Host ($names.Count.ToString() + ' images listees dans liste.js')"
rem Génère aussi liste_formes.js : les formes alternatives (dossier "allformealternative") et leurs shiny ("allformealternativeshiny")
powershell -NoProfile -ExecutionPolicy Bypass -Command "$a = @(Get-ChildItem -LiteralPath '%~dp0allformealternative' -File -ErrorAction SilentlyContinue | Where-Object { $_.Extension -match '^\.(gif|png|jpe?g|webp|avif|bmp)$' } | ForEach-Object { $_.Name }); $s = @(Get-ChildItem -LiteralPath '%~dp0allformealternativeshiny' -File -ErrorAction SilentlyContinue | Where-Object { $_.Extension -match '^\.(gif|png|jpe?g|webp|avif|bmp)$' } | ForEach-Object { $_.Name }); $ja = ConvertTo-Json -InputObject $a -Compress; $js = ConvertTo-Json -InputObject $s -Compress; [System.IO.File]::WriteAllText('%~dp0liste_formes.js', 'window.POKEMON_FORMES_LIST = ' + $ja + ';' + [char]10 + 'window.POKEMON_FORMES_SHINY_LIST = ' + $js + ';', (New-Object System.Text.UTF8Encoding($false))); Write-Host ($a.Count.ToString() + ' formes et ' + $s.Count.ToString() + ' formes shiny listees dans liste_formes.js')"
pause
